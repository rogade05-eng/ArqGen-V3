{
  "code": "fire_cause_effect_v1",
  "name": "Matriz causa/efecto de incendios (reglas del spec 44)",
  "description": "INPUT -> CONDITION -> ACTION -> OUTPUT -> DELAY. Reglas parametrizadas por datos; los códigos INPUT coinciden con los kinds de dispositivos (SMOKE_DETECTOR, HEAT_DETECTOR, BEAM_DETECTOR, CALL_POINT, FIRE_MODULE).",
  "version": "1.0",
  "rules": [
    {

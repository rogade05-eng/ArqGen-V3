        {"action": "alarma", "output": "FIRE_PANEL", "delay_s": 0.0},
        {"action": "senializacion", "output": "SOUNDER", "delay_s": 0.0},
        {"action": "senializacion", "output": "STROBE", "delay_s": 0.0},
        {"action": "evento_control", "output": "FIRE_MODULE", "delay_s": 5.0},
        {"action": "registro", "output": "EVENT_LOG", "delay_s": 0.0}
      ]
    },
